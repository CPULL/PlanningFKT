<?xml version="1.0" encoding="utf-8"?>
<!-- Kept in the project root so "dotnet publish" uses it as the base for the
     published web.config (it only adds the aspNetCore handler/settings and
     keeps everything below). Cache-Control: no-cache on every response makes
     browsers re-check index.html, app.js and app.css with the server at each
     load: an unchanged file costs a tiny "304 Not Modified", a new deploy is
     picked up immediately - no more clearing the cache on each tablet (CPU). -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
